+    @MainThread
+    private fun configureAndroidCustomActions(options: Bundle) {
+        if (androidCustomActions.isEmpty()) return
+
+        val mediaSessionConnector = runCatching {
+            val field = player.notificationManager.javaClass
+                .getDeclaredField(MEDIA_SESSION_CONNECTOR_FIELD)
+            field.isAccessible = true
+            field.get(player.notificationManager) as MediaSessionConnector
+        }.getOrElse { error ->
+            Timber.e(error, "Unable to access the media session connector")
+            return
+        }
+
+        val providers = buildList {
+            if (notificationCapabilities.contains(Capability.JUMP_BACKWARD)) {
+                add(
+                    createMediaSessionAction(
+                        id = JUMP_BACKWARD_ACTION_ID,
+                        title = "Back 15 seconds",
+                        icon = BundleUtils.getIcon(
+                            this@MusicService,
+                            options,
+                            "rewindIcon",
+                            TrackPlayerR.drawable.rewind,
+                        ),
+                        onAction = ::jumpBackward,
+                    )
+                )
+            }
+            if (notificationCapabilities.contains(Capability.JUMP_FORWARD)) {
+                add(
+                    createMediaSessionAction(
+                        id = JUMP_FORWARD_ACTION_ID,
+                        title = "Forward 15 seconds",
+                        icon = BundleUtils.getIcon(
+                            this@MusicService,
+                            options,
+                            "forwardIcon",
+                            TrackPlayerR.drawable.forward,
+                        ),
+                        onAction = ::jumpForward,
+                    )
+                )
+            }
+            androidCustomActions.forEach { action ->
+                add(
+                    createMediaSessionAction(
+                        id = action.id,
+                        title = action.title,
+                        icon = action.icon,
+                        onAction = { handleCustomAction(action) },
+                    )
+                )
+            }
+        }
